PORTAL_ENVIRONMENT=
PORTAL_DEPLOYMENT=
DATABASE_MIGRATION_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=
BOOTSTRAP_OWNER_EMAIL=
BLOB_READ_WRITE_TOKEN=
CHANT_BLOB_TOKEN=

# Optional PocketTorah reference metadata. Absent/false releases stay OFF.
# Native Production OIDC only; no static Blob token is used by short references.
BLOB_STORE_ID=
REFERENCE_AUDIO_CATALOG_SHA256=
REFERENCE_AUDIO_STUDENT_RELEASE=
REFERENCE_AUDIO_SHORT_PUBLIC_RELEASE=
REFERENCE_AUDIO_SHORT_MANIFEST_SHA256=

# Optional fixed-CRC service broker and a separate automatic-drain credential.
BEIT_MITZVAH_MUSIC_URL=
BEIT_MITZVAH_SERVICE_TOKEN=
CRON_SECRET=

# Release 1.1 email notifications: off unless exactly "true" (and each kind is also switched on in Congregation settings).
PORTAL_NOTIFICATIONS_ENABLED=
