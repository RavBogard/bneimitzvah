  },
  "units": [
    {
      "id": "reading",
      "title": "Reading Hebrew",
      "summary": "Letters, vowels and syllables, then whole lines from the prayers. Start here if Hebrew letters are new to you, or skip ahead.",
      "phase": "morning",
      "map": false,
      "lessons": [
        "f1",
        "f2",
        "f3",
        "f4",
        "f5",
        "f6"
      ]
    },
    {
      "id": "leads",
      "title": "The parts every student leads",
      "summary": "The Sh’ma, the V’ahavta, and the blessings before and after the Torah and haftarah readings. Most students lead all six.",
      "phase": "morning",
      "map": false,
      "lessons": [
        "shma",
        "vahavta",
        "torah-before",
        "torah-after",
        "haftarah-before",
        "haftarah-after"
      ]
    },
    {
      "id": "waking",
      "title": "Morning blessings",
      "summary": "From waking up to the call to prayer: Modeh Ani, the tallit, Mah Tovu, the morning blessings and the verses of song.",
      "phase": "morning",
      "map": true,
      "lessons": [
        "modeh-ani",
        "tallit",
        "mah-tovu",
        "hineih-mah-tov",
        "birchot-hashachar",
        "psukei-dzimrah",
        "chatzi-kaddish"
      ]
    },
    {
      "id": "shma",
      "title": "The Sh’ma and its blessings",
      "summary": "Bar’chu calls us together. Two blessings lead to the Sh’ma, and Mi Chamochah carries us toward the Amidah.",
      "phase": "morning",
      "map": true,
      "lessons": [
        "barchu",
        "yotzeir-or",
        "ahavah-rabbah",
        "mi-chamochah"
      ]
    },
    {
      "id": "amidah",
      "title": "The Amidah",
      "summary": "The standing prayer: seven blessings on Shabbat, from our ancestors to peace, then a moment of silence.",
      "phase": "morning",
      "map": true,
      "lessons": [
        "tfilah",
        "avot-vimahot",
        "gvurot",
        "kdushah",
        "vshamru",
        "avodah",
        "hodaah",
        "sim-shalom",
        "oseh-shalom"
      ]
    },
    {
      "id": "torah",
      "title": "The Torah service",
      "summary": "Taking out the Torah, the readings, the healing prayer, and returning the scroll to the ark.",
      "phase": "morning",
      "map": true,
      "lessons": [
        "torah-service",
        "torah-reading",
        "mi-shebeirach",
        "haftarah-reading",
        "commentary",
        "eitz-chayim"
      ]
    },
    {
      "id": "closing",
      "title": "Closing the service",
      "summary": "Aleinu, the Mourner’s Kaddish, Adon Olam and the blessings that send us out.",
      "phase": "morning",
      "map": true,
      "lessons": [
        "aleinu",
        "mourners-kaddish",
        "adon-olam",
        "parents-blessing",
        "closing-blessing"
      ]
    }
  ],
