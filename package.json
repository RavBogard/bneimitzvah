{
  "name": "crc-bneimitzvah",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/private-media-single-write-probe.mjs && node scripts/private-media-oidc-probe.mjs && node scripts/private-media-object-probe.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:node && npm run test:app",
    "test:node": "node --test \"tests/**/*.test.mjs\"",
    "test:app": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "npm run test:postgres:sql && npm run test:postgres:access",
    "test:postgres:sql": "node --test --test-concurrency=1 \"tests/postgres/*.integration.mjs\"",
    "test:postgres:access": "vitest run --config vitest.postgres.config.mts",
    "test:http:browser": "vitest run --config vitest.http-browser.config.mts",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:auth-schema": "auth generate --config scripts/db-auth-config.ts --output .local-logs/auth-schema.generated.ts --yes",
    "check:repo": "node --test tests/never-in-repo.test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "@vercel/oidc": "3.8.10",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.10",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
